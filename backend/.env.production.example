# ============================================================
# Production Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ----- Django -----
SECRET_KEY=<generate-a-secure-key>
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ENVIRONMENT=production

# ----- External Database -----
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<database-host-or-ip>
DB_PORT=5432

# ----- Cloudflare R2 (Static & Media Files) -----
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=quran-apps-directory
R2_PUBLIC_URL=https://pub-<your-bucket-hash>.r2.dev

# ----- CORS -----
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----- Security -----
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ----- Nginx / TLS (self-contained compose) -----
# When running via docker-compose.prod.yml, Nginx terminates TLS and
# reverse-proxies to Django. Django already trusts the proxy header
# (SECURE_PROXY_SSL_HEADER in config/settings/production.py).
#
# SERVER_NAME: public domain(s) nginx serves (sets nginx server_name + cert CN).
#   Defaults to localhost. Export it before compose up:
#   SERVER_NAME=example.com,www.example.com docker compose -f docker-compose.prod.yml up -d
#
# Certificates: place real ones at backend/certs/ (relative to repo root),
#   mounted into nginx (read-write, so auto-generated self-signed certs can be written there):
#     - fullchain.pem
#     - privkey.pem
# If no certificates are present, nginx auto-generates a self-signed cert
# (openssl, 825 days) for SERVER_NAME at startup.

# ----- Site -----
SITE_URL=https://yourdomain.com

# ----- Email (Optional) -----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<email-username>
EMAIL_HOST_PASSWORD=<email-password>
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ----- Sentry (Optional) -----
SENTRY_DSN=
